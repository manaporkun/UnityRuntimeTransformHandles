<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ProductConfigurator.uss" />
    <ui:VisualElement name="workshop" class="demo-shell" picking-mode="Ignore">
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement class="identity" picking-mode="Ignore">
                <ui:Button name="demo-gallery" text="‹ Demos" class="demo-gallery-link" />
                <ui:Label text="Product configurator" class="app-title" />
                <ui:Label text="Desk collection" class="project-name" />
            </ui:VisualElement>
            <ui:VisualElement class="header-actions" picking-mode="Ignore">
                <ui:Button name="reset" text="Reset scene" class="quiet-button" />
                <ui:Button name="help-toggle" text="Help" class="quiet-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="inspector" class="inspector" horizontal-scroller-visibility="Hidden">
            <ui:Label text="SELECTION" class="eyebrow" />
            <ui:Label name="selection-name" text="Select a product" class="selection-name" />
            <ui:Label name="selection-hint" text="Click a product. Shift-click adds to selection." class="description selection-hint" />
            <ui:VisualElement class="tools">
                <ui:Button name="move" class="tool-button">
                    <ui:VisualElement class="tool-icon move-icon" picking-mode="Ignore" />
                    <ui:Label text="Move" />
                </ui:Button>
                <ui:Button name="rotate" class="tool-button">
                    <ui:VisualElement class="tool-icon rotate-icon" picking-mode="Ignore" />
                    <ui:Label text="Rotate" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="constraints"><ui:Label text="Space" class="muted" /><ui:Button name="space" text="World" class="constraint-button" /></ui:VisualElement>
            <ui:VisualElement class="divider" picking-mode="Ignore" />
            <ui:Label name="finish-label" text="Finish" class="section-title" />
            <ui:VisualElement class="finish-options">
                <ui:Button name="finish-white" text="White" class="finish-option white" />
                <ui:Button name="finish-graphite" text="Graphite" class="finish-option graphite" />
                <ui:Button name="finish-sand" text="Sand" class="finish-option sand" />
            </ui:VisualElement>
            <ui:VisualElement class="divider" picking-mode="Ignore" />
            <ui:VisualElement class="size-row">
                <ui:Label text="Handle size" class="section-title" />
                <ui:VisualElement class="size-value">
                    <ui:TextField name="size-input" value="192" max-length="10" />
                    <ui:Label text="px" class="unit" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:SliderInt name="size-slider" low-value="64" high-value="512" value="192" />
            <ui:VisualElement class="range-labels" picking-mode="Ignore">
                <ui:Label text="64" /><ui:Label text="512" />
            </ui:VisualElement>
            <ui:Label text="Adjust to your display." class="description size-hint" />
        </ui:ScrollView>
        <ui:VisualElement name="help-backdrop" class="help-backdrop hidden">
            <ui:VisualElement name="help-card" class="help-card">
                <ui:VisualElement class="help-heading">
                    <ui:Label text="Workshop controls" class="section-title" />
                    <ui:Button name="help-close" text="×" class="close-button" />
                </ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="Move / Rotate" /><ui:Label text="W / E" class="muted" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="Orbit" /><ui:Label text="Left-drag" class="muted" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="Pan" /><ui:Label text="Right-drag" class="muted" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:Label text="Zoom" /><ui:Label text="Scroll" class="muted" /></ui:VisualElement>
                <ui:VisualElement class="divider" picking-mode="Ignore" />
                <ui:Label name="status" class="description status" />
                <ui:Label text="Keep the whole product on the desk. An invalid placement restores the entire move. Products can overlap. Reset restores positions and finishes." class="description help-note" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
