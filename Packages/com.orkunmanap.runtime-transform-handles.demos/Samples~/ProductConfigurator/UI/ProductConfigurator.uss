@import url("DemoTheme.uss");
.demo-shell .move-icon { background-image: url("Move.png"); }
.demo-shell .rotate-icon { background-image: url("Rotate.png"); }

.demo-shell .finish-options { flex-direction: row; margin-top: 12px; }
.demo-shell .finish-option { flex-grow: 1; flex-basis: 0; margin-right: 4px; padding: 0 4px; font-size: 16px; border-width: 1px; border-color: rgb(224,228,234); }
.demo-shell .finish-option.selected { border-color: rgb(67,120,204); background-color: rgb(230,239,253); }
